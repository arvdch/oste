# OSTE Environment Configuration
# Copy this file to .env and fill in your API keys

# Server
PORT=3000
NODE_ENV=development

# GitHub API (optional: unauthenticated mode gets 60 req/hr with 6h caching; token raises limit to 5000 req/hr and enables issue/PR metrics)
# Get a token at: https://github.com/settings/tokens
GITHUB_TOKEN=

# NVD API (optional: unauthenticated mode gets 5 req/30s with 6.5s pacing; key raises limit to 50 req/30s)
# Request at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# VirusTotal API (required for freeware URL, domain, and file hash analysis; free tier is 4 req/min, paced at 15.5s)
# Get at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Hybrid Analysis API (optional: enables Falcon Sandbox behavioral threat score for freeware)
# Get at: https://www.hybrid-analysis.com/apikeys/info
HYBRID_ANALYSIS_API_KEY=

# Groq API (recommended for AI security narrative; falls back to deterministic rule-based summary if omitted)
# Get at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional runtime tuning
# GROQ_MODEL=openai/gpt-oss-120b
# OSTE_MAX_CONCURRENT=3
# OSTE_NO_CACHE=1
